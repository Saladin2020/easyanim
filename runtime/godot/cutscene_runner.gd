extends Node2D
class_name EasyAnimCutscene
## Easy Anim cutscene runner (Godot 4.3+). Plays an `easyanim/1` cutscene exported as normalized JSON.
##
##   var cs := preload("res://easyanim/scenes/village_morning_delivery.tscn").instantiate()
##   add_child(cs)                  # autoplay; emits finished when done
##   cs.finished.connect(func(): cs.queue_free())
##
## Actors are AnimatedSprite2D children of Actors/ (SpriteFrames per Easy Sprite sheet, one animation per
## facing: right / left / front, frame = sheet column). The runner sets animation + frame from the timeline,
## so playback is deterministic and seekable. Camera2D, a fade ColorRect and a dialogue box are driven the same way.
##
## Hooks into the rest of Easy Suite when present:
##   - Easy FX:    res://easyfx/scenes/<id>.tscn is instanced for fx spawns (else a small placeholder burst)
##   - Easy Music: /root/MusicPlayer.play(id, fade) / stop(fade)
##   - Easy SFX:   /root/SfxBank.play(id)
##   - Easy Dialogue: line_shown(speaker, text, ref) carries the `file.ezd#node` ref for your dialogue runner
## state_at(t) is a straight port of src/shared/evaluate.ts; test_anim.gd checks it against the TypeScript.
## Generated by Easy Anim (MIT).

signal started
signal finished
signal line_shown(speaker: String, text: String, ref: String)
signal sfx(id: String)
signal music(id: String, fade: float)
signal music_stop(fade: float)
signal fx_spawned(id: String, position: Vector2)
signal waiting_for_input

const CPS := 28.0
const FRAME := 48
const COLUMNS := ["idle", "walk0", "walk1", "walk2", "run0", "run1", "run2", "run3", "jump0", "jump1", "wave0", "wave1", "carry0", "carry1", "farm0", "farm1", "cheer0", "cheer1", "attack0", "attack1", "hurt0", "hurt1", "fall0", "fall1", "sleep0", "sleep1", "tired0", "tired1", "sit", "crouch"]
const ANIMS := {
	"idle": {"frames": ["idle"], "fps": 1.0, "loop": true},
	"walk": {"frames": ["walk0", "walk1", "walk2", "walk1"], "fps": 8.0, "loop": true},
	"run": {"frames": ["run0", "run1", "run2", "run3"], "fps": 10.0, "loop": true},
	"jump": {"frames": ["jump0", "jump1"], "fps": 4.0, "loop": false},
	"wave": {"frames": ["wave0", "wave1"], "fps": 4.0, "loop": true},
	"carry": {"frames": ["carry0", "carry1"], "fps": 6.0, "loop": true},
	"farm": {"frames": ["farm0", "farm1"], "fps": 3.0, "loop": true},
	"cheer": {"frames": ["cheer0", "cheer1"], "fps": 4.0, "loop": true},
	"attack": {"frames": ["attack0", "attack1"], "fps": 8.0, "loop": false},
	"hurt": {"frames": ["hurt0", "hurt1"], "fps": 6.0, "loop": false},
	"fall": {"frames": ["fall0", "fall1"], "fps": 4.0, "loop": false},
	"sleep": {"frames": ["sleep0", "sleep1"], "fps": 1.5, "loop": true},
	"tired": {"frames": ["tired0", "tired1"], "fps": 2.0, "loop": true},
	"sit": {"frames": ["sit"], "fps": 1.0, "loop": true},
	"crouch": {"frames": ["crouch"], "fps": 1.0, "loop": true},
}

@export_file("*.json") var cutscene_path := ""
@export var autoplay := true
## Continue past wait_input after its preview duration instead of waiting for advance() / ui_accept.
@export var auto_advance := false
@export var speed := 1.0
@export var font: Font

var data: Dictionary = {}
var time := 0.0
var playing := false
var waiting := false
var _actors: Dictionary = {}
var _camera: Camera2D
var _fade: ColorRect
var _box: Panel
var _name: Label
var _text: Label
var _cursor := 0


func _ready() -> void:
	if cutscene_path != "" and load_cutscene(cutscene_path) and autoplay:
		play()


func load_cutscene(path: String) -> bool:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_error("EasyAnim: cannot open %s" % path)
		return false
	var parsed = JSON.parse_string(f.get_as_text())
	if typeof(parsed) != TYPE_DICTIONARY or parsed.get("format", "") != "easyanim/1":
		push_error("EasyAnim: %s is not an easyanim/1 cutscene" % path)
		return false
	data = parsed
	_build()
	seek(0.0)
	return true


func duration() -> float:
	return float(data.get("duration", 0.0))


func play() -> void:
	playing = true
	started.emit()


func pause() -> void:
	playing = false


func advance() -> void:
	waiting = false


func seek(t: float) -> void:
	time = clampf(t, 0.0, duration())
	waiting = false
	# events at exactly t fire on the next frame when seeking to 0, otherwise only later ones
	_cursor = 0
	var events: Array = data.get("events", [])
	while _cursor < events.size() and (float(events[_cursor]["t"]) < time or (time > 0.0 and float(events[_cursor]["t"]) <= time)):
		_cursor += 1
	_apply(state_at(time))


func _unhandled_input(event: InputEvent) -> void:
	if waiting and event.is_action_pressed("ui_accept"):
		advance()


func _process(delta: float) -> void:
	if not playing or waiting or data.is_empty():
		return
	var t1 := minf(duration(), time + delta * speed)
	var events: Array = data["events"]
	while _cursor < events.size() and float(events[_cursor]["t"]) <= t1:
		var ev: Dictionary = events[_cursor]
		_cursor += 1
		_fire(ev)
		if ev["op"] == "wait_input" and not auto_advance:
			t1 = float(ev["t"])
			waiting = true
			waiting_for_input.emit()
			break
	time = t1
	_apply(state_at(time))
	if time >= duration() and not waiting and _cursor >= events.size():
		playing = false
		finished.emit()


func _fire(ev: Dictionary) -> void:
	match String(ev["op"]):
		"sfx":
			sfx.emit(ev["sfx"])
			var bank := _autoload("SfxBank")
			if bank and bank.has_method("play"):
				bank.play(ev["sfx"])
		"music":
			music.emit(ev["music"], float(ev.get("fade", 1.0)))
			var mp := _autoload("MusicPlayer")
			if mp:
				mp.play(ev["music"], float(ev.get("fade", 1.0)))
		"music_stop":
			music_stop.emit(float(ev.get("fade", 1.0)))
			var mp2 := _autoload("MusicPlayer")
			if mp2:
				mp2.stop(float(ev.get("fade", 1.0)))
		"spawn":
			var s := state_at(float(ev["t"]))
			for f in s["fx"]:
				if int(f["i"]) == int(ev["i"]):
					var pos := Vector2(f["x"], f["y"])
					fx_spawned.emit(ev["fx"], pos)
					_spawn_fx(String(ev["fx"]), pos, float(ev["dur"]))
		"line":
			var st := state_at(float(ev["t"]))
			if st["line"] != null:
				line_shown.emit(st["line"]["speaker"] if st["line"]["speaker"] != null else "", st["line"]["text"], st["line"]["ref"] if st["line"]["ref"] != null else "")


func _spawn_fx(id: String, pos: Vector2, dur: float) -> void:
	var scene_path := "res://easyfx/scenes/%s.tscn" % id
	if ResourceLoader.exists(scene_path):
		var n: Node2D = load(scene_path).instantiate()
		n.position = pos
		$Actors.add_child(n)
		if dur > 0.0:
			_free_later(n, dur)
		return
	var p := CPUParticles2D.new()
	p.position = pos
	p.amount = 12
	p.lifetime = maxf(0.3, minf(dur, 1.5))
	p.one_shot = dur < 3.0
	p.explosiveness = 0.8 if p.one_shot else 0.0
	p.direction = Vector2(0, -1)
	p.spread = 70.0
	p.initial_velocity_min = 10.0
	p.initial_velocity_max = 30.0
	p.gravity = Vector2(0, 20)
	p.color = Color("#ffd86a")
	p.emitting = true
	$Actors.add_child(p)
	_free_later(p, maxf(dur, p.lifetime) + 0.1)


func _autoload(autoload_name: String) -> Node:
	if not is_inside_tree():
		return null
	return get_tree().root.get_node_or_null(autoload_name)


func _free_later(n: Node, delay: float) -> void:
	if not is_inside_tree():
		n.queue_free()
		return
	await get_tree().create_timer(delay).timeout
	if is_instance_valid(n):
		n.queue_free()


# ------------------------------------------------------------------ evaluation (port of evaluate.ts)

static func _ease(kind, k: float) -> float:
	if k <= 0.0:
		return 0.0
	if k >= 1.0:
		return 1.0
	if kind == "in":
		return k * k
	if kind == "out":
		return 1.0 - (1.0 - k) * (1.0 - k)
	if kind == "inOut":
		return 2.0 * k * k if k < 0.5 else 1.0 - 2.0 * (1.0 - k) * (1.0 - k)
	return k


static func _progress(ev: Dictionary, t: float) -> float:
	var d := float(ev["dur"])
	return minf(1.0, (t - float(ev["t"])) / d) if d > 0.0 else 1.0


static func is_thai_combining(c: int) -> bool:
	return c == 0x0E31 or (c >= 0x0E34 and c <= 0x0E3A) or (c >= 0x0E47 and c <= 0x0E4E)


static func safe_count(text: String, n: int) -> int:
	var c := clampi(n, 0, text.length())
	if c > 0 and c < text.length() and text.unicode_at(c - 1) >= 0x0E40 and text.unicode_at(c - 1) <= 0x0E44:
		c += 1
	while c < text.length() and c > 0 and is_thai_combining(text.unicode_at(c)):
		c += 1
	return c


static func frame_of(anim: String, start: float, t: float) -> String:
	var a: Dictionary = ANIMS.get(anim, ANIMS["idle"])
	var n := int(floor((t - start) * float(a["fps"]) + 0.000001))
	var frames: Array = a["frames"]
	var length := frames.size()
	var idx := 0
	if a["loop"]:
		idx = ((n % length) + length) % length
	else:
		idx = clampi(n, 0, length - 1)
	return frames[idx]


func actors_at(t: float) -> Array:
	var work := {}
	var order := []
	for a in data["actors"]:
		work[a["id"]] = {"id": a["id"], "x": float(a["x"]), "y": float(a["y"]), "face": a["face"], "anim": a["anim"], "start": 0.0, "rest": a["anim"], "visible": a["visible"]}
		order.append(a["id"])
	for ev in data["events"]:
		if float(ev["t"]) > t:
			break
		if ev["track"] != "actor" or not work.has(ev["actor"]):
			continue
		var a: Dictionary = work[ev["actor"]]
		var et := float(ev["t"])
		var d := float(ev["dur"])
		match String(ev["op"]):
			"move":
				var to: Array = ev["to"]
				var k := _progress(ev, t)
				var e := _ease(ev.get("ease", "linear"), k)
				if ev.has("face") and typeof(ev["face"]) == TYPE_STRING:
					a["face"] = ev["face"]
				elif float(to[0]) > a["x"]:
					a["face"] = "right"
				elif float(to[0]) < a["x"]:
					a["face"] = "left"
				a["x"] = a["x"] + (float(to[0]) - a["x"]) * e
				a["y"] = a["y"] + (float(to[1]) - a["y"]) * e
				if k < 1.0:
					a["anim"] = ev["anim"]
					a["start"] = et
				else:
					a["anim"] = a["rest"]
					a["start"] = et + d
			"face":
				a["face"] = ev["dir"]
			"anim":
				if d > 0.0:
					if t < et + d:
						a["anim"] = ev["anim"]
						a["start"] = et
					else:
						a["anim"] = a["rest"]
						a["start"] = et + d
				else:
					a["anim"] = ev["anim"]
					a["rest"] = ev["anim"]
					a["start"] = et
			"show":
				a["visible"] = true
			"hide":
				a["visible"] = false
	var out := []
	for id in order:
		var a: Dictionary = work[id]
		out.append({"id": id, "x": a["x"], "y": a["y"], "face": a["face"], "anim": a["anim"], "frame": frame_of(a["anim"], a["start"], t), "visible": a["visible"]})
	return out


func state_at(t: float) -> Dictionary:
	var st: Dictionary = data["stage"]
	var cam := {"x": float(st["camera"]["x"]), "y": float(st["camera"]["y"]), "zoom": float(st["camera"]["zoom"]), "sx": 0.0, "sy": 0.0}
	var fade := {"a": 0.0, "color": "#000000"}
	var line = null
	var fx := []
	var music_id = null
	var lang: String = data.get("lang", "th")
	for ev in data["events"]:
		var et := float(ev["t"])
		if et > t:
			break
		var k := _progress(ev, t)
		var d := float(ev["dur"])
		var track: String = ev["track"]
		var op: String = ev["op"]
		if track == "camera":
			if op == "pan":
				var e := _ease(ev.get("ease", "inOut"), k)
				cam["x"] = cam["x"] + (float(ev["to"][0]) - cam["x"]) * e
				cam["y"] = cam["y"] + (float(ev["to"][1]) - cam["y"]) * e
			elif op == "zoom":
				cam["zoom"] = cam["zoom"] + (float(ev["to"]) - cam["zoom"]) * _ease(ev.get("ease", "inOut"), k)
			elif op == "shake" and t < et + d:
				var u := t - et
				var amp := float(ev["amp"]) * (1.0 - k)
				cam["sx"] = amp * sin(u * 94.2477796)
				cam["sy"] = amp * cos(u * 69.1150384)
		elif track == "screen" and op == "fade":
			fade["a"] = fade["a"] + (float(ev["to"]) - fade["a"]) * k
			fade["color"] = ev["color"]
		elif track == "dialogue" and t < et + d:
			var text := ""
			if lang == "th":
				text = String(ev.get("th", ev.get("en", "")))
			else:
				text = String(ev.get("en", ev.get("th", "")))
			var speaker = ev.get("speaker", null)
			var name := ""
			if speaker != null:
				for a in data["actors"]:
					if a["id"] == speaker:
						var nm: Dictionary = a.get("name", {})
						name = String(nm.get(lang, nm.get("en" if lang == "th" else "th", a["id"])))
			var shown := safe_count(text, int(floor((t - et) * CPS + 0.000001)))
			line = {"i": int(ev["i"]), "speaker": speaker, "name": name, "text": text, "shown": shown, "ref": ev.get("ref", null), "done": shown >= text.length()}
		elif track == "fx" and t < et + d:
			var x := 0.0
			var y := 0.0
			var off: Array = ev["offset"]
			if ev.has("at") and typeof(ev["at"]) == TYPE_ARRAY:
				x = float(ev["at"][0])
				y = float(ev["at"][1])
			elif ev.has("actor"):
				for a in actors_at(et):
					if a["id"] == ev["actor"]:
						x = a["x"]
						y = a["y"]
			fx.append({"i": int(ev["i"]), "fx": ev["fx"], "x": x + float(off[0]), "y": y + float(off[1]), "age": t - et, "dur": d})
		elif track == "audio":
			if op == "music":
				music_id = ev["music"]
			elif op == "music_stop":
				music_id = null
	var half_w := float(st["width"]) / (2.0 * float(cam["zoom"]))
	var half_h := float(st["height"]) / (2.0 * float(cam["zoom"]))
	var ww := float(st["worldWidth"])
	var wh := float(st["worldHeight"])
	cam["x"] = ww / 2.0 if ww <= 2.0 * half_w else clampf(cam["x"], half_w, ww - half_w)
	cam["y"] = wh / 2.0 if wh <= 2.0 * half_h else clampf(cam["y"], half_h, wh - half_h)
	return {"t": t, "actors": actors_at(t), "camera": cam, "fade": fade, "line": line, "fx": fx, "music": music_id}


# ------------------------------------------------------------------ nodes

func _build() -> void:
	var st: Dictionary = data["stage"]
	if not has_node("Actors"):
		var actors := Node2D.new()
		actors.name = "Actors"
		add_child(actors)
	for a in data["actors"]:
		var spr: AnimatedSprite2D = get_node_or_null("Actors/" + String(a["id"]))
		if spr == null:
			spr = AnimatedSprite2D.new()
			spr.name = a["id"]
			var res := "res://easyanim/sprites/%s.tres" % a["sprite"]
			if ResourceLoader.exists(res):
				spr.sprite_frames = load(res)
			spr.centered = false
			spr.offset = Vector2(-24.0, -47.0)
			$Actors.add_child(spr)
		_actors[a["id"]] = spr
	_camera = get_node_or_null("Camera")
	if _camera == null:
		_camera = Camera2D.new()
		_camera.name = "Camera"
		add_child(_camera)
	if is_inside_tree():
		_camera.make_current()
	var ui := CanvasLayer.new()
	ui.layer = 10
	add_child(ui)
	var vw := float(st["width"])
	var vh := float(st["height"])
	_box = Panel.new()
	_box.position = Vector2(8, 6)
	_box.size = Vector2(vw - 16, 44)
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color("#21160e")
	sb.border_color = Color("#f4ae3d")
	sb.set_border_width_all(1)
	_box.add_theme_stylebox_override("panel", sb)
	_box.visible = false
	ui.add_child(_box)
	_name = Label.new()
	_name.position = Vector2(6, 2)
	_name.add_theme_color_override("font_color", Color("#f4ae3d"))
	_name.add_theme_font_size_override("font_size", 9)
	_box.add_child(_name)
	_text = Label.new()
	_text.position = Vector2(6, 13)
	_text.size = Vector2(vw - 28, 30)
	_text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_text.add_theme_color_override("font_color", Color("#f7ebd3"))
	_text.add_theme_font_size_override("font_size", 9)
	_box.add_child(_text)
	if font == null and ResourceLoader.exists("res://easyanim/fonts/Kanit-Regular.ttf"):
		font = load("res://easyanim/fonts/Kanit-Regular.ttf")
	if font:
		_name.add_theme_font_override("font", font)
		_text.add_theme_font_override("font", font)
	_fade = ColorRect.new()
	_fade.size = Vector2(vw, vh)
	_fade.color = Color(0, 0, 0, 0)
	_fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ui.add_child(_fade)


func _apply(s: Dictionary) -> void:
	for a in s["actors"]:
		var spr: AnimatedSprite2D = _actors.get(a["id"])
		if spr == null:
			continue
		spr.visible = a["visible"]
		spr.position = Vector2(round(a["x"]), round(a["y"]))
		spr.z_index = int(a["y"])
		if spr.sprite_frames and spr.sprite_frames.has_animation(a["face"]):
			spr.animation = a["face"]
			spr.frame = max(0, COLUMNS.find(a["frame"]))
	var c: Dictionary = s["camera"]
	_camera.position = Vector2(c["x"] + c["sx"], c["y"] + c["sy"])
	_camera.zoom = Vector2(c["zoom"], c["zoom"])
	var col := Color(s["fade"]["color"])
	col.a = clampf(s["fade"]["a"], 0.0, 1.0)
	_fade.color = col
	var ln = s["line"]
	_box.visible = ln != null
	if ln != null:
		_name.text = ln["name"]
		_name.visible = ln["name"] != ""
		_text.text = ln["text"] if ln["text"] != "" else "[Easy Dialogue: %s]" % ln["ref"]
		_text.visible_characters = ln["shown"] if ln["text"] != "" else -1
