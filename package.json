{
  "name": "easyanim",
  "version": "0.1.0",
  "description": "Local CLI + web tool for JSON cutscene timelines (easyanim/1): actors, camera, dialogue, FX, SFX/music cues and fades, previewed live and exported to a Godot 4.3+ cutscene runner and a PixiJS v8 runner",
  "type": "module",
  "bin": {
    "easyanim": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "samples",
    "assets",
    "web/dist",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts serve --dev",
    "build": "npm run build:core && npm run build:server && npm run build:web",
    "build:server": "tsup src/cli.ts src/mcp/server.ts --format esm --dts --clean --out-dir dist",
    "build:web": "vite build --config web/vite.config.ts",
    "serve": "tsx src/cli.ts serve",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:http": "tsx src/mcp/server.ts --http --port 8869",
    "init": "tsx src/cli.ts init",
    "icons": "tsx scripts/write-icons.mts",
    "capture:ui": "python3 scripts/capture-ui.py",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:tools": "node scripts/smoke-mcp-tools.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "smoke": "npm run smoke:tools && npm run smoke:cli",
    "docs:images": "tsx scripts/render-docs.mts docs/assets",
    "check:pixi": "python3 scripts/check-pixi.py",
    "build:core": "node scripts/build-core.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.1.1",
    "commander": "^14.0.3",
    "hono": "^4.13.18",
    "open": "^10.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.27.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
